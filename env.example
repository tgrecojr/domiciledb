# ─── DomicileDB operator configuration ───────────────────────────────────────
# Everything here is set by the OPERATOR at deploy/runtime. None of it is
# surfaced as an end-user setting. Copy to `.env` and fill in real values.
# NEVER commit `.env`.

# Where the app stores its SQLite db, media, and backups (mounted volume).
DATA_DIR=/data

# ─── AI Assist (OpenRouter) ──────────────────────────────────────────────────
# Remote AI is opt-in per action. Leave the key blank to disable AI features.
OPENROUTER_API_KEY=
# A vision-capable model id, e.g. openai/gpt-4o or anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4o
# Override only for an OpenAI-compatible gateway (default is OpenRouter).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Your site URL, sent as HTTP-Referer so OpenRouter attributes usage to this app
# (required to pair with X-OpenRouter-Title "DomicileDB" for an app page). Optional.
OPENROUTER_REFERER=https://your-domain.example
# Ceiling on paid AI calls per rolling hour (spend guard). Requests over the
# limit are refused before anything is sent to the provider.
AI_MAX_CALLS_PER_HOUR=60

# ─── Off-site backup (S3 / S3-compatible: AWS, MinIO, Backblaze B2, R2) ───────
# Leave S3_BUCKET blank to disable scheduled backups.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# cron expression for scheduled backups (default: nightly at 03:00)
BACKUP_CRON=0 3 * * *

# ─── Upload & media storage limits ───────────────────────────────────────────
# Largest single accepted photo/document upload, in MB.
UPLOAD_MAX_FILE_MB=25
# Most files honoured from one capture/upload request; extras are ignored.
UPLOAD_MAX_FILES_PER_REQUEST=20
# Ceiling on total bytes stored under DATA_DIR/media, in MB (default 20 GB).
MEDIA_MAX_TOTAL_MB=20480
# Largest single file /api/media will serve (bigger files get HTTP 413).
MEDIA_MAX_SERVE_MB=100

# ─── Export throttling ───────────────────────────────────────────────────────
# Minimum seconds between full /api/export runs (each is a db VACUUM + a zip of
# the whole media tree). Concurrent or earlier requests get HTTP 429.
EXPORT_MIN_INTERVAL_SECONDS=60
# Most items one proof-packet PDF will render; larger asks get HTTP 413 and
# must be narrowed with ?location= or ?category=.
PROOF_PACKET_MAX_ITEMS=2000

# ─── Coverage & valuation tuning ─────────────────────────────────────────────
# Fraction of the Coverage B limit at which the "approaching limit" nudge fires.
COVERAGE_WARN_PCT=0.80
# How many days before a replacement-cost value is considered stale (quarterly).
REVALUATION_CADENCE_DAYS=90

# ─── Security notice ─────────────────────────────────────────────────────────
# This app has NO built-in authentication. It MUST be deployed behind a trusted
# network boundary (VPN) and/or a reverse proxy that handles auth + HTTPS.
# HTTPS is required for PWA install, offline support, and live camera capture.
